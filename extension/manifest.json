{
  "manifest_version": 3,
  "name": "Detector de odio en comentarios",
  "version": "0.1.0",
  "description": "Marca los comentarios de YouTube que un modelo de aprendizaje automático considera posible discurso de odio. Es una estimación: puede equivocarse.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Detector de odio" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
