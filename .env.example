# Copia este archivo a .env y ajusta los valores. NO subas .env a git.

# Modelo a servir (si se omite, la API usa ensemble_v1 si existe y cumple el requisito de gap; si no, baseline_v3)
HATEDET_MODEL_PATH=models/ensemble_v1.joblib

# Clave de la API (cabecera X-API-Key). Genera una con: openssl rand -hex 32
HATEDET_API_KEY=

# Origenes permitidos por CORS (expresion regular). Por defecto: localhost y extensiones de navegador.
HATEDET_CORS_REGEX='^(chrome-extension://.*|https?://(localhost|127\.0\.0\.1)(:\d+)?)$'

# Clave de la YouTube Data API v3 (opcional). Sin ella se usa un extractor sin clave (menos estable).
YOUTUBE_API_KEY=

# Puertos del HOST (solo 127.0.0.1). Cambialos si en tu maquina ya hay algo en el 8000 / 8501.
# Dentro de los contenedores no cambian. Si cambias HATEDET_API_PORT, actualiza tambien el proxy (deploy/Caddyfile).
HATEDET_API_PORT=8000
HATEDET_UI_PORT=8501

# Maximo de seguimientos en directo simultaneos
HATEDET_MAX_MONITORS=5

# Cola de revision humana. VACIO = apagada. Es la unica pieza que almacena el texto de comentarios
# reales (necesario para revisarlos): activala solo si vas a moderar, y revisa la nota de RGPD del
# README. En Docker usa la ruta del volumen: /app/review/review.db
HATEDET_REVIEW_DB=
